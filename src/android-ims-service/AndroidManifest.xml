<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.octolab.qcom32ims"
    android:sharedUserId="android.uid.phone"
    android:versionCode="9"
    android:versionName="2.9-qcom32-volte">

    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="30" />

    <!-- Intentionally zero <uses-permission> declarations so com.android.phone retains its exact granted permissions. -->
    <application
        android:label="Qcom32 VoLTE IMS"
        android:process=":qcom32ims"
        android:directBootAware="true"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:debuggable="false">

        <service
            android:name=".Qcom32VolteImsService"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_IMS_SERVICE">
            <intent-filter>
                <action android:name="android.telephony.ims.ImsService" />
            </intent-filter>
            <meta-data
                android:name="android.telephony.ims.MMTEL_FEATURE"
                android:value="true" />
        </service>

        <service
            android:name=".VolteBootstrapService"
            android:exported="false"
            android:directBootAware="true" />

        <receiver
            android:name=".CarrierConfigBootstrapReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.telephony.action.CARRIER_CONFIG_CHANGED" />
                <action android:name="android.telephony.action.DEFAULT_SUBSCRIPTION_CHANGED" />
                <action android:name="android.intent.action.SIM_STATE_CHANGED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".VolteAdminReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.MODIFY_PHONE_STATE">
            <intent-filter>
                <action android:name="org.octolab.qcom32ims.ACTION_ADMIN" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".VolteStatusProvider"
            android:authorities="org.octolab.qcom32ims.status"
            android:exported="true"
            android:directBootAware="true" />
    </application>
</manifest>
